+// <copyright file="GameplayRateKind.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.PlugIns;
+
+/// <summary>
+/// The kinds of rates which can be modified by an <see cref="IGameplayRateModifierPlugIn"/>.
+/// </summary>
+public enum GameplayRateKind
+{
+    /// <summary>
+    /// A multiplier for the chance of the chance based item drop groups of a killed monster. The initial value is 1.0.
+    /// </summary>
+    ItemDropChanceMultiplier,
+
+    /// <summary>
+    /// The success rate of an item crafting in percent (0 to 100). The initial value is the rate of the crafting.
+    /// </summary>
+    CraftingSuccessRate,
+
+    /// <summary>
+    /// A multiplier for the zen cost of the MU helper. The initial value is 1.0.
+    /// </summary>
+    MuHelperZenCostMultiplier,
+}
