+// <copyright file="IGameplayRateModifierPlugIn.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.PlugIns;
+
+using System.Runtime.InteropServices;
+using MUnique.OpenMU.PlugIns;
+
+/// <summary>
+/// A plugin interface which is called when a player related rate is determined, so that it
+/// can be modified, e.g. by a premium membership.
+/// </summary>
+/// <remarks>
+/// Because the plugins are not called in a defined order, they should only apply factors or
+/// summands which are independent of each other.
+/// </remarks>
+[Guid("0C8F5A3E-6B1D-4E27-9F4A-2D7C1B8E5A90")]
+[PlugInPoint("Gameplay rate modifier", "Plugins which modify player related rates, like the item drop chance, the crafting success rate or the MU helper cost.")]
+public interface IGameplayRateModifierPlugIn
+{
+    /// <summary>
+    /// Is called when a rate is determined for the player.
+    /// </summary>
+    /// <param name="player">The player.</param>
+    /// <param name="args">The arguments, which hold the rate.</param>
+    void ModifyRate(Player player, GameplayRateArgs args);
+}
