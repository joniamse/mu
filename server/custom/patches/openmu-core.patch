+// <copyright file="GameplayRateArgs.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.PlugIns;
+
+/// <summary>
+/// The arguments of the <see cref="IGameplayRateModifierPlugIn"/>. Plugin points can't return
+/// values, so the rate is passed in and out through this object.
+/// </summary>
+public sealed class GameplayRateArgs
+{
+    /// <summary>
+    /// Initializes a new instance of the <see cref="GameplayRateArgs"/> class.
+    /// </summary>
+    /// <param name="kind">The kind of the rate.</param>
+    /// <param name="value">The initial value of the rate.</param>
+    public GameplayRateArgs(GameplayRateKind kind, double value)
+    {
+        this.Kind = kind;
+        this.Value = value;
+    }
+
+    /// <summary>
+    /// Gets the kind of the rate.
+    /// </summary>
+    public GameplayRateKind Kind { get; }
+
+    /// <summary>
+    /// Gets or sets the value of the rate. It can be modified by the plugins.
+    /// </summary>
+    public double Value { get; set; }
+}
